        MsgBox "EDUCATION: This is how Clipboard Hijacking works. You just ran a script because you trusted a website instructions. Be careful!", 48, "NoGettingHacked.com"
        Self.Close
    End Sub
</script>
</head>
<body style="background:#000;color:#0f0;text-align:center;font-family:sans-serif;">
